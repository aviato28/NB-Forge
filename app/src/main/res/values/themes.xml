<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Forge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorAccent">@color/forge_ember</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SplashScreen API: app icon on charcoal. -->
    <style name="Theme.Forge.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/forge_charcoal</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/forge_charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Forge</item>
    </style>
</resources>
